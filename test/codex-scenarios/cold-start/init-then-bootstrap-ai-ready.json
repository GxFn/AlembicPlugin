{
  "id": "init-then-codex-host-bootstrap",
  "description": "用户先初始化再要求知识挖掘，Codex 冷启动走无状态 Plan（draft→confirm）后再启动 host-agent bootstrap workflow，不依赖 provider-backed daemon job 配置，也不创建 daemon job。",
  "fixture": {
    "daemon": "stopped",
    "initialized": false,
    "knowledge": "none",
    "project": "minimal-node",
    "projectRoot": "explicit"
  },
  "turns": [
    {
      "user": "初始化 Alembic"
    },
    {
      "user": "开始 Alembic 知识挖掘"
    }
  ],
  "expect": {
    "toolCalls": [
      {
        "name": "alembic_status",
        "arguments": {
          "projectRoot": "$projectRoot"
        },
        "result": {
          "success": true,
          "data.project.trust": "trusted"
        }
      },
      {
        "name": "alembic_init",
        "arguments": {
          "projectRoot": "$projectRoot"
        },
        "result": {
          "success": true
        }
      },
      {
        "name": "alembic_plan",
        "arguments": {
          "operation": "draft",
          "projectRoot": "$projectRoot"
        },
        "result": {
          "success": true
        }
      },
      {
        "name": "alembic_plan",
        "arguments": {
          "operation": "confirm",
          "projectRoot": "$projectRoot"
        },
        "result": {
          "success": true,
          "data.operation": "confirm",
          "data.planSelection.generationStage": "coldStart"
        }
      },
      {
        "name": "alembic_bootstrap",
        "arguments": {
          "projectRoot": "$projectRoot"
        },
        "result": {
          "success": true,
          "data.serviceBoundary.executionPath": "plugin-owned-codex-facing",
          "data.serviceBoundary.owner": "alembic-plugin"
        }
      }
    ],
    "sideEffects": {
      "initMarkerWritten": true,
      "jobCreated": false,
      "savedProjectRootWritten": true,
      "secretWritten": false
    },
    "state": {
      "initializedAfterRun": true,
      "workspace": {
        "configExists": true,
        "databaseExists": true,
        "knowledgeExists": true,
        "runtimeExists": true
      }
    },
    "assistant": {
      "mustMention": ["host-agent bootstrap", "Mission Briefing"],
      "mustNotMention": ["没有启动", "AI Provider", "知识挖掘任务已入队"]
    }
  },
  "steps": [
    {
      "name": "alembic_status",
      "arguments": {
        "projectRoot": "$projectRoot"
      }
    },
    {
      "name": "alembic_init",
      "arguments": {
        "projectRoot": "$projectRoot"
      }
    },
    {
      "name": "alembic_plan",
      "arguments": {
        "operation": "draft",
        "projectRoot": "$projectRoot",
        "hints": {
          "maxBudget": 3
        }
      }
    },
    {
      "name": "alembic_plan",
      "arguments": {
        "operation": "confirm",
        "projectRoot": "$projectRoot",
        "generationStage": "coldStart",
        "projectProfile": {
          "projectType": "node-app",
          "primaryLanguage": "javascript",
          "secondaryLanguages": [],
          "frameworks": [],
          "moduleCount": 1,
          "fileCount": 2
        },
        "selectedDimensions": [
          {
            "dimensionId": "$toolResult:3:data.candidateDimensions.0.id",
            "priority": 1,
            "rationale": "Codex session init-then-bootstrap Plan gate scenario",
            "targetRecipes": 1
          }
        ],
        "scale": {
          "totalRecipeBudget": 1,
          "depthLevels": ["project"]
        },
        "moduleBindings": [
          {
            "modulePath": "src",
            "dimensions": ["$toolResult:3:data.candidateDimensions.0.id"],
            "targetRecipes": 1,
            "priority": 1
          }
        ],
        "plannedNextActions": [
          {
            "tool": "alembic_bootstrap",
            "order": 1,
            "reason": "Run the confirmed Plan-gated host-agent bootstrap."
          }
        ],
        "evidenceRefs": [
          {
            "kind": "project-context",
            "ref": "projectInfoTree:L0",
            "detail": "draft projectInfoTree root"
          }
        ],
        "rationale": "Codex session init-then-bootstrap Plan gate scenario"
      }
    },
    {
      "name": "alembic_bootstrap",
      "arguments": {
        "projectRoot": "$projectRoot",
        "planSelection": "$toolResult:4:data.planSelection"
      }
    }
  ]
}
